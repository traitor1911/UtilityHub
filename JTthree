-- // ITEM ESP LOGIC
------------------------------------------------
local ItemESPConfig = {
	["Jet Black"]     = Color3.fromRGB(128, 0, 128),
	["Playful Cloud"] = Color3.fromRGB(180, 0, 30),
	["Naginata"]      = Color3.fromRGB(255, 105, 180),
	["Sniper"]        = Color3.fromRGB(255, 255, 0),
}

local itemESPConnections = {}

local function applyItemESPToObject(item, color)
	-- only apply to the top-level named object, not its children
	if item:FindFirstChild("ItemESPHighlight") then return end

	-- get adornee: for models use primary/first basepart, for parts use itself
	local rootPart
	if item:IsA("Model") then
		rootPart = item.PrimaryPart or item:FindFirstChildWhichIsA("BasePart")
	elseif item:IsA("BasePart") then
		rootPart = item
	else
		return -- not something we can adorn
	end

	if not rootPart then return end

	local h = Instance.new("Highlight")
	h.Name = "ItemESPHighlight"
	h.Adornee = item
	h.FillColor = color
	h.FillTransparency = 0.5
	h.OutlineColor = color
	h.Parent = item

	local bb = Instance.new("BillboardGui")
	bb.Name = "ItemESPLabel"
	bb.Adornee = rootPart
	bb.Size = UDim2.new(0,120,0,30)
	bb.StudsOffset = Vector3.new(0,3,0)
	bb.AlwaysOnTop = true
	bb.Parent = item

	local lbl = Instance.new("TextLabel", bb)
	lbl.Size = UDim2.new(1,0,1,0)
	lbl.BackgroundTransparency = 1
	lbl.Text = item.Name
	lbl.Font = Enum.Font.GothamBold
	lbl.TextSize = 14
	lbl.TextColor3 = color
	lbl.TextStrokeTransparency = 0
	lbl.TextStrokeColor3 = Color3.new(0,0,0)
end

local function removeItemESPFromObject(item)
	local h = item:FindFirstChild("ItemESPHighlight")
	if h then h:Destroy() end
	local bb = item:FindFirstChild("ItemESPLabel")
	if bb then bb:Destroy() end
end

local function clearItemESP()
	for _, c in ipairs(itemESPConnections) do
		c:Disconnect()
	end
	itemESPConnections = {}

	local items = workspace:FindFirstChild("Items")
	if items then
		for _, item in pairs(items:GetChildren()) do
			removeItemESPFromObject(item)
		end
	end
end

local function startItemESPWatcher()
	local items = workspace:FindFirstChild("Items")
	if not items then
		local c = workspace.ChildAdded:Connect(function(child)
			if child.Name == "Items" then
				startItemESPWatcher()
			end
		end)
		table.insert(itemESPConnections, c)
		return
	end

	-- apply to all existing direct children of Items
	for _, item in pairs(items:GetChildren()) do
		local color = ItemESPConfig[item.Name]
		if color then
			applyItemESPToObject(item, color)
		end
	end

	-- watch for new DIRECT children only (not descendants)
	local c1 = items.ChildAdded:Connect(function(item)
		if not ItemESPEnabled then return end
		local color = ItemESPConfig[item.Name]
		if color then
			task.wait(0.1) -- let the object fully load
			applyItemESPToObject(item, color)
		end
	end)
	table.insert(itemESPConnections, c1)

	local c2 = items.ChildRemoved:Connect(function(item)
		removeItemESPFromObject(item)
	end)
	table.insert(itemESPConnections, c2)
end

local function toggleItemESP()
	ItemESPEnabled = not ItemESPEnabled
	ItemESPBtn.Text = "Item ESP: "..(ItemESPEnabled and "ON" or "OFF")

	if ItemESPEnabled then
		startItemESPWatcher()
	else
		clearItemESP()
	end
end

