local function checkMovesetForRCooldown()
	if gModeActive then return 1.7 end

	local playerGui = lp:FindFirstChild("PlayerGui")
	if not playerGui then return 0 end
	local mainGui = playerGui:FindFirstChild("Main")
	if not mainGui then return 0 end
	local moveset = mainGui:FindFirstChild("Moveset")
	if not moveset then return 0 end

	if moveset:FindFirstChild("Stabilize") then return 6.7 end
	if moveset:FindFirstChild("Collapse") then return 1.7 end

	return 0
end

local function startRCooldown(duration)
	rKeyCooldown = true
	rCooldownTime = duration
	task.spawn(function()
		task.wait(duration)
		rKeyCooldown = false
		rCooldownTime = 0
	end)
end

------------------------------------------------
-- // NANAMI KICK LOGIC
------------------------------------------------
local function pressKey(key)
	VirtualInputManager:SendKeyEvent(true, key, false, game)
end

local function releaseKey(key)
	VirtualInputManager:SendKeyEvent(false, key, false, game)
end

local function smoothTurn(hrp, degrees, duration)
	local startTime = tick()
	local startCF = hrp.CFrame
	local goalCF = startCF * CFrame.Angles(0, math.rad(degrees), 0)

	while tick() - startTime < duration do
		local alpha = (tick() - startTime) / duration
		hrp.CFrame = startCF:Lerp(goalCF, alpha)
		RunService.RenderStepped:Wait()
	end

	hrp.CFrame = goalCF
end

local function executeNanamiKick()
	local character = lp.Character
	if not character then return end

	local humanoid = character:FindFirstChildOfClass("Humanoid")
	local hrp = character:FindFirstChild("HumanoidRootPart")
	if not humanoid or not hrp then return end

	local wasPressingW = UserInputService:IsKeyDown(Enum.KeyCode.W)
	local wasPressingA = UserInputService:IsKeyDown(Enum.KeyCode.A)
	local wasPressingD = UserInputService:IsKeyDown(Enum.KeyCode.D)

	if wasPressingW then releaseKey(Enum.KeyCode.W) end
	if wasPressingA then releaseKey(Enum.KeyCode.A) end
	if wasPressingD then releaseKey(Enum.KeyCode.D) end

	pressKey(Enum.KeyCode.S)

	local t = tick()
	while tick() - t < keyGap do
		RunService.RenderStepped:Wait()
	end

	pressKey(Enum.KeyCode.Two)
	RunService.RenderStepped:Wait()
	releaseKey(Enum.KeyCode.Two)

	local oldAutoRotate = humanoid.AutoRotate
	humanoid.AutoRotate = false

	smoothTurn(hrp, 180, turnTime)

	local holdStart = tick()
	while tick() - holdStart < turnDuration do
		RunService.RenderStepped:Wait()
	end

	smoothTurn(hrp, -180, turnTime)

	humanoid.AutoRotate = oldAutoRotate
	releaseKey(Enum.KeyCode.S)

	if wasPressingW then pressKey(Enum.KeyCode.W) end
	if wasPressingA then pressKey(Enum.KeyCode.A) end
	if wasPressingD then pressKey(Enum.KeyCode.D) end
end

