local function applyHighlight(plr)
	if not HighlightEnabled or plr == lp or not plr.Character then return end
	local humanoid = plr.Character:FindFirstChild("Humanoid")
	if humanoid and humanoid.Health <= 0 then return end
	clearHighlight(plr)
	local color = getColor(plr)
	local h = Instance.new("Highlight")
	h.Name = plr.Name
	h.Adornee = plr.Character
	h.FillColor = color
	h.FillTransparency = 0.6
	h.OutlineColor = Color3.new(1,1,1)
	h.Parent = HighlightFolder
	createTag(plr, color)
end

local function applyDummyHighlights()
	if not HighlightEnabled then return end
	clearDummyHighlights()
	for _, obj in pairs(workspace:GetDescendants()) do
		if obj.Name == "Dummy" and obj:FindFirstChild("Humanoid") then
			local humanoid = obj:FindFirstChild("Humanoid")
			if humanoid and humanoid.Health > 0 then
				local h = Instance.new("Highlight")
				h.Name = "Dummy_" .. obj:GetDebugId()
				h.Adornee = obj
				h.FillColor = DummyColor
				h.FillTransparency = 0.6
				h.OutlineColor = Color3.new(1,1,1)
				h.Parent = HighlightFolder
			end
		end
	end
end

local function updateHighlight(plr)
	if not HighlightEnabled or plr == lp or not plr.Character then return end
	local char = plr.Character
	local humanoid = char and char:FindFirstChild("Humanoid")
	if not humanoid or humanoid.Health <= 0 then clearHighlight(plr) return end

	local color = getColor(plr)
	local highlight = HighlightFolder:FindFirstChild(plr.Name)
	if highlight then highlight.FillColor = color end

	local highlightTag = char:FindFirstChild("HighlightTag")
	if highlightTag then
		local healthLabel = highlightTag:FindFirstChild("TextLabel")
		if healthLabel then
			healthLabel.Text = math.floor(humanoid.Health) .. "/" .. math.floor(humanoid.MaxHealth)
			healthLabel.TextColor3 = getHealthColor(humanoid)
		end
		for _, child in pairs(highlightTag:GetChildren()) do
			if child:IsA("TextLabel") and child ~= healthLabel then
				child.TextColor3 = color
			end
		end
	end
end

