local function preciseWait(duration)
	local start = os.clock()
	while os.clock() - start < duration do
		task.wait()
	end
end

local function pressKeyOld(keyCode, holdTime)
	VirtualInputManager:SendKeyEvent(true, keyCode, false, game)
	preciseWait(holdTime)
	VirtualInputManager:SendKeyEvent(false, keyCode, false, game)
end

local function pressR()
	isSimulated = true
	VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.R, false, game)
	preciseWait(0.01)
	VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.R, false, game)
	isSimulated = false
end

local function tweenRotationAsync(part, targetCFrame, duration)
	local tweenInfo = TweenInfo.new(duration, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
	local tween = TweenService:Create(part, tweenInfo, {CFrame = targetCFrame})
	tween:Play()
end

local function executeTodoBF()
	local character = lp.Character or lp.CharacterAdded:Wait()
	local humanoid = character:WaitForChild("Humanoid")
	local hrp = character:WaitForChild("HumanoidRootPart")
	character.PrimaryPart = hrp

	local originalAutoRotate = humanoid.AutoRotate
	humanoid.AutoRotate = false

	local originalCFrame = hrp.CFrame
	local flippedCFrame = originalCFrame * CFrame.Angles(0, math.rad(180), 0)

	tweenRotationAsync(hrp, flippedCFrame, 0.15)

	pressKeyOld(Enum.KeyCode.Three, 0.159)
	preciseWait(0.743)
	pressKeyOld(Enum.KeyCode.R, 0.192)

	humanoid.AutoRotate = originalAutoRotate
	tweenRotationAsync(hrp, originalCFrame, 0.12)
	preciseWait(0.260)

	pressKeyOld(Enum.KeyCode.Two, 0.136)
	preciseWait(0.500)
	pressKeyOld(Enum.KeyCode.Two, 0.001)
end

local function getClosestPlayerToMouse()
	local closest, shortest = nil, math.huge
	for _,p in ipairs(Players:GetPlayers()) do
		if p ~= lp and p.Character then
			local part = p.Character:FindFirstChild("HumanoidRootPart")
			if part then
				local pos = camera:WorldToScreenPoint(part.Position)
				local dist = (Vector2.new(mouse.X,mouse.Y) - Vector2.new(pos.X,pos.Y)).Magnitude
				if dist < shortest then
					shortest = dist
					closest = p
				end
			end
		end
	end
	return closest
end

local function checkAutoNanamiSwitch()
	if not NanamiREnabled then return end

	local closestPlayer = getClosestPlayerToMouse()

	if closestPlayer and closestPlayer.Character then
		local humanoid = closestPlayer.Character:FindFirstChild("Humanoid")
		if humanoid then
			local maxHealth = humanoid.MaxHealth
			local currentHealth = humanoid.Health
			local threshold

			if maxHealth == 85 then threshold = 62
			elseif maxHealth == 100 then threshold = 76
			elseif maxHealth == 90 then threshold = 69
			elseif maxHealth == 70 then threshold = 50
			else threshold = maxHealth * 0.76 end

			if currentHealth < threshold then
				if delayTime ~= 0.45 then
					delayTime = 0.45
					fastMode = true
					updateNanamiIndicator()
				end
				return
			end
		end
	end

	if delayTime ~= 0.60 then
		delayTime = 0.60
		fastMode = false
		updateNanamiIndicator()
	end
end

local conn18 = UserInputService.InputBegan:Connect(function(input,gp)
	if gp then return end

	if input.KeyCode == Enum.KeyCode.J then
		toggleHighlight()
	elseif input.KeyCode == Enum.KeyCode.Y then
		toggleLock()
	elseif input.KeyCode == Enum.KeyCode.LeftBracket then
		toggleSeriousMode()
		for _, obj in pairs(workspace:GetDescendants()) do
			if obj.Name == "Dummy" and obj:FindFirstChild("Humanoid") then
				local highlight = Instance.new("Highlight")
				highlight.Parent = obj
			end
		end
	elseif input.KeyCode == Enum.KeyCode.G then
		if NanamiREnabled then
			activateGMode()
		end
	elseif input.KeyCode == Enum.KeyCode.T then
		if NanamiREnabled then
			fastMode = not fastMode
			delayTime = fastMode and 0.45 or 0.60
			updateNanamiIndicator()
		elseif TodoBFEnabled then
			executeTodoBF()
		end
	elseif input.KeyCode == Enum.KeyCode.Five then
		if NanamiKickEnabled then
			executeNanamiKick()
		end
	elseif input.KeyCode == Enum.KeyCode.P then
		if NanamiREnabled and not isSimulated and not rKeyCooldown then
			local cooldownDuration = checkMovesetForRCooldown()
			if cooldownDuration > 0 then
				startRCooldown(cooldownDuration)
				checkAutoNanamiSwitch()
				task.spawn(function()
					pressR()
					preciseWait(delayTime)
					pressR()
				end)
			end
