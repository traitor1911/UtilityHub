local function activateGMode()
	if gModeActive then return end

	gModeActive = true
	gModeEndTime = tick() + 65
	if NanamiRVisualsEnabled then
		GModeIndicator.Visible = true
		NanamiIndicator.BackgroundColor3 = Color3.fromRGB(255,165,0)
		NanamiIndicatorLabel.Text = "G MODE"
	end

	-- Delete OvertimeAura music and play client-side music
	if lp.Character then
		local setAssets = workspace.Characters:FindFirstChild(lp.Name)
		if setAssets then
			setAssets = setAssets:FindFirstChild("SetAssets")
			if setAssets then
				local overtimeAura = setAssets:FindFirstChild("OvertimeAura")
				if overtimeAura then
					local music = overtimeAura:FindFirstChild("Music")
					if music and music:IsA("Sound") then
						music:Stop()
						music:Destroy()
					end
				end
			end
		end
	end

	-- Create client-side music
	gModeMusic = Instance.new("Sound", workspace)
	gModeMusic.SoundId = "rbxassetid://129827447835246"
	gModeMusic.Volume = 0.5
	gModeMusic.Looped = true
	gModeMusic:Play()

	game.StarterGui:SetCore("SendNotification", {
		Title = "G Mode Activated",
		Text = "1.7s cooldown for 65 seconds",
		Duration = 3
	})

	task.spawn(function()
		while gModeActive and tick() < gModeEndTime do
			local remaining = math.ceil(gModeEndTime - tick())
			if NanamiRVisualsEnabled then
				GModeIndicatorLabel.Text = "G MODE: " .. remaining .. "s"
			end
			task.wait(0.1)
		end

		gModeActive = false
		GModeIndicator.Visible = false

		if gModeMusic then
			gModeMusic:Stop()
			gModeMusic:Destroy()
			gModeMusic = nil
		end

		if NanamiREnabled and NanamiRVisualsEnabled then
			NanamiIndicator.BackgroundColor3 = Color3.fromRGB(0,255,0)
			NanamiIndicatorLabel.Text = "0.60s"
		end

		game.StarterGui:SetCore("SendNotification", {
			Title = "G Mode Ended",
			Text = "Back to normal mode",
			Duration = 2
		})
	end)
end

